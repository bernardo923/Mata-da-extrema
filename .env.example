# Senha única para acesso ao app (defina algo forte em produção)
APP_PASSWORD=trocar-essa-senha

# URL do Postgres (Railway provê automaticamente quando o plugin estiver linkado)
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Porta (Railway define automaticamente)
PORT=3000

# Senha do vaqueiro — abre apenas a tela de campo em /campo (pesagens, ração, contas a pagar)
VAQUEIRO_PASSWORD=trocar-essa-senha-do-vaqueiro
